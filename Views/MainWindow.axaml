<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:SparkleMail.Models"
        x:Class="SparkleMail.MainWindow"
        Title="SparkleMail" Width="1180" Height="740" MinWidth="940" MinHeight="580"
        RequestedThemeVariant="Dark" Background="#14161A" Foreground="#E6E8EC" FontSize="14">

  <!--
    Шкала відступів: 4 · 8 · 12 · 16 · 24 · 32
    Радіуси:         8 (поля, кнопки) · 10 (рядки списку) · 12 (картки)
    Шрифти:          11 (статус) · 12 (допоміжний) · 14 (основний) · 15 (текст листа) · 24 (заголовок)
  -->

  <Window.Resources>
    <SolidColorBrush x:Key="Base">#14161A</SolidColorBrush>
    <SolidColorBrush x:Key="Panel">#1A1D23</SolidColorBrush>
    <SolidColorBrush x:Key="Line">#262A32</SolidColorBrush>
    <SolidColorBrush x:Key="Muted">#8B93A1</SolidColorBrush>
    <SolidColorBrush x:Key="Accent">#5B8CFF</SolidColorBrush>
    <SolidColorBrush x:Key="Hover">#22262E</SolidColorBrush>
    <SolidColorBrush x:Key="Selected">#222C45</SolidColorBrush>
  </Window.Resources>

  <Window.Styles>

    <!-- ===== Списки ===== -->
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="8,1"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="ListBox.msgs ListBoxItem">
      <Setter Property="Margin" Value="8,2"/>
      <Setter Property="CornerRadius" Value="10"/>
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Hover}"/>
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Selected}"/>
    </Style>

    <!-- ===== Кнопки ===== -->
    <Style Selector="Button.primary, ToggleButton.primary, Button.flat, ToggleButton.flat">
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="Padding" Value="16,0"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.primary, ToggleButton.primary">
      <Setter Property="Background" Value="{StaticResource Accent}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="ToggleButton.primary:checked /template/ ContentPresenter, ToggleButton.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Accent}"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style Selector="Button.flat, ToggleButton.flat">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="Padding" Value="12,0"/>
    </Style>
    <Style Selector="Button.flat:pointerover /template/ ContentPresenter, ToggleButton.flat:pointerover /template/ ContentPresenter, ToggleButton.flat:checked /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Hover}"/>
      <Setter Property="Foreground" Value="#E6E8EC"/>
    </Style>

    <!-- ===== Поля вводу ===== -->
    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="Padding" Value="12,9"/>
      <Setter Property="Background" Value="{StaticResource Panel}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
    </Style>
    <Style Selector="Border.card TextBox">
      <Setter Property="Background" Value="{StaticResource Base}"/>
    </Style>

    <Style Selector="TextBox.plain">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0,12"/>
      <Setter Property="MinHeight" Value="44"/>
    </Style>
    <Style Selector="TextBox.plain:pointerover /template/ Border#PART_BorderElement, TextBox.plain:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>

    <!-- ===== Типографіка ===== -->
    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="24"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="TextBlock.meta">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style Selector="TextBlock.unread">
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style Selector="TextBlock.unreadSubject">
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="TextBlock.read">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
    </Style>

    <!-- ===== Картки ===== -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{StaticResource Panel}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="24"/>
    </Style>
    <Style Selector="Border.badge">
      <Setter Property="Background" Value="{StaticResource Accent}"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="8,1"/>
    </Style>
    <Style Selector="Border.avatar">
      <Setter Property="Width" Value="36"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="CornerRadius" Value="18"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>
    <Style Selector="Border.hr">
      <Setter Property="Height" Value="1"/>
      <Setter Property="Background" Value="{StaticResource Line}"/>
    </Style>

  </Window.Styles>

  <Grid RowDefinitions="*,Auto">

    <Grid ColumnDefinitions="232,Auto,348,Auto,*">

      <!-- ================= САЙДБАР ================= -->
      <Border Background="{StaticResource Panel}">
        <DockPanel Margin="0,24,0,16">

          <TextBlock DockPanel.Dock="Top" Text="SparkleMail" FontSize="16" FontWeight="Bold"
                     Margin="24,0,24,24"/>

          <ToggleButton x:Name="BtnCompose" DockPanel.Dock="Top" Classes="primary"
                        Content="Написати" Margin="16,0,16,16" MinHeight="40"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>

          <StackPanel DockPanel.Dock="Bottom" Margin="16,12,16,0" Spacing="8">
            <Border Classes="hr"/>
            <TextBlock x:Name="TxtAccount" Text="kuroshi@ukr.net" Classes="meta" Margin="12,8,0,0"/>
            <ToggleButton x:Name="BtnSettings" Classes="flat" Content="Налаштування"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
          </StackPanel>

          <ListBox x:Name="FolderList" Background="Transparent" SelectedIndex="0">
            <ListBoxItem>
              <Grid ColumnDefinitions="*,Auto" Margin="16,10">
                <TextBlock Text="Вхідні" FontWeight="SemiBold"/>
                <Border Grid.Column="1" Classes="badge">
                  <TextBlock x:Name="BadgeCount" Text="0" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                </Border>
              </Grid>
            </ListBoxItem>
            <ListBoxItem><TextBlock Text="Надіслані" Margin="16,10"/></ListBoxItem>
          </ListBox>

        </DockPanel>
      </Border>

      <Border Grid.Column="1" Width="1" Background="{StaticResource Line}"/>

      <!-- ================= СПИСОК ЛИСТІВ ================= -->
      <DockPanel Grid.Column="2">

        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="24,20,12,12">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock x:Name="ListTitle" Text="Вхідні" Classes="h2"/>
          </StackPanel>
          <Button x:Name="BtnRefresh" Grid.Column="1" Classes="flat" Content="Оновити"/>
        </Grid>

        <!-- Баннер першого запуску -->
        <Border x:Name="NoAccountBanner" DockPanel.Dock="Top" Margin="16,0,16,12" Padding="16,12" CornerRadius="10"
                Background="#252215" BorderBrush="#3F3820" BorderThickness="1">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBlock Text="Акаунт не налаштовано" Foreground="#E3C565" VerticalAlignment="Center"/>
            <ToggleButton Grid.Column="1" Classes="flat" Content="Перейти" MinHeight="32"
                          IsChecked="{Binding #BtnSettings.IsChecked, Mode=TwoWay}"/>
          </Grid>
        </Border>

        <Border DockPanel.Dock="Top" Classes="hr"/>

        <ListBox x:Name="MessageList" Classes="msgs" Background="Transparent" Padding="0,8">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="models:EmailMessageModel">
              <Grid ColumnDefinitions="Auto,*" Margin="12">
                <Border Classes="avatar" Background="#34467A" Margin="0,0,12,0">
                  <TextBlock Text="{Binding Initial}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Spacing="2">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Sender}" Classes.unread="{Binding !IsSeen}" Classes.read="{Binding IsSeen}" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Date, StringFormat={}{0:dd.MM HH:mm}}" Classes="meta"/>
                      <Ellipse Width="8" Height="8" Fill="{StaticResource Accent}" IsVisible="{Binding !IsSeen}"/>
                    </StackPanel>
                  </Grid>
                  <TextBlock Text="{Binding Subject}" Classes.unreadSubject="{Binding !IsSeen}" Classes.read="{Binding IsSeen}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

      </DockPanel>

      <Border Grid.Column="3" Width="1" Background="{StaticResource Line}"/>

      <!-- ================= ПРАВА ЧАСТИНА ================= -->
      <Panel Grid.Column="4">

        <!-- Читання листа: шапка + WebView -->
        <DockPanel Margin="40,32,40,24">
          <StackPanel DockPanel.Dock="Top" Spacing="24" Margin="0,0,0,24">
            <TextBlock x:Name="ReaderSubject" Text="Оберіть лист" Classes="h1" TextWrapping="Wrap"/>

            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Classes="avatar" Width="44" Height="44" CornerRadius="22" Background="#34467A">
                <TextBlock x:Name="ReaderAvatar" Text="?" FontWeight="SemiBold" FontSize="16"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center" Spacing="2">
                <TextBlock x:Name="ReaderSenderName" FontWeight="SemiBold"/>
                <TextBlock x:Name="ReaderSenderEmail" Classes="meta"/>
              </StackPanel>
              <TextBlock x:Name="ReaderDate" Grid.Column="2" Classes="meta" VerticalAlignment="Center"/>
            </Grid>

            <Border Classes="hr"/>
          </StackPanel>

          <NativeWebView x:Name="ReaderWeb"/>
        </DockPanel>

        <!-- Нове повідомлення -->
        <Border Background="{StaticResource Base}" IsVisible="{Binding #BtnCompose.IsChecked}">
          <DockPanel Margin="40,24,40,24">

            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
              <TextBlock Text="Нове повідомлення" Classes="h2" VerticalAlignment="Center"/>
              <ToggleButton Grid.Column="1" Classes="flat" Width="36" Padding="0"
                            IsChecked="{Binding #BtnCompose.IsChecked, Mode=TwoWay}">
                <Path Data="M0,0 L10,10 M10,0 L0,10" Width="10" Height="10" Stretch="Fill"
                      Stroke="{Binding $parent[ToggleButton].Foreground}" StrokeThickness="1.5"/>
              </ToggleButton>
            </Grid>

            <StackPanel DockPanel.Dock="Bottom" Spacing="16" Margin="0,16,0,0">
              <Border Classes="hr"/>
              <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="12">
                <Button x:Name="BtnSend" Classes="primary" Content="Надіслати" Padding="24,0"/>
              </Grid>
            </StackPanel>

            <StackPanel DockPanel.Dock="Top">
              <Border Classes="hr"/>
              <Grid ColumnDefinitions="72,*">
                <TextBlock Text="Кому" Classes="meta" VerticalAlignment="Top" Margin="0,15,0,0"/>
                <TextBox x:Name="TxtTo" Grid.Column="1" Classes="plain" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="120"
                         PlaceholderText="user@example.com"/>
              </Grid>
              <TextBlock x:Name="AddrCount" Text="Кілька адрес, кожна з нового рядка - це розсилка · Адрес: 0" Classes="meta"
                         Margin="72,0,0,12"/>
              <Border Classes="hr"/>
              <Grid ColumnDefinitions="72,*">
                <TextBlock Text="Тема" Classes="meta" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtSubject" Grid.Column="1" Classes="plain"/>
              </Grid>
              <Border Classes="hr"/>
            </StackPanel>

            <TextBox x:Name="TxtBody" Classes="plain" AcceptsReturn="True" TextWrapping="Wrap" FontSize="15"
                     Padding="0,16" VerticalContentAlignment="Top" PlaceholderText="Текст листа"/>
          </DockPanel>
        </Border>
      </Panel>

      <!-- ================= НАЛАШТУВАННЯ ================= -->
      <Border Grid.Column="2" Grid.ColumnSpan="3" Background="{StaticResource Base}"
              IsVisible="{Binding #BtnSettings.IsChecked}">
        <ScrollViewer>
          <StackPanel Margin="40,32" Spacing="24" MaxWidth="760" HorizontalAlignment="Left">

            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
              <ToggleButton Classes="flat" Content="← Назад" HorizontalAlignment="Left" Margin="-12,0,0,0"
                            IsChecked="{Binding #BtnSettings.IsChecked, Mode=TwoWay}"
                            VerticalAlignment="Center"/>
              <TextBlock Text="Налаштування" Classes="h1" VerticalAlignment="Center"/>
            </StackPanel>

            <Border Classes="card">
              <StackPanel Spacing="16">
                <StackPanel Spacing="4">
                  <TextBlock Text="Обліковий запис" FontWeight="SemiBold"/>
                  <TextBlock Text="Один логін і пароль для вхідної та вихідної пошти" Classes="meta"/>
                </StackPanel>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                  <StackPanel><TextBlock Text="Логін" Classes="label"/><TextBox x:Name="TxtLogin"/></StackPanel>
                  <StackPanel Grid.Column="1"><TextBlock Text="Пароль" Classes="label"/><TextBox x:Name="TxtPassword" PasswordChar="●"/></StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="16">
                <StackPanel Spacing="4">
                  <TextBlock Text="Вихідна пошта" FontWeight="SemiBold"/>
                  <TextBlock Text="SMTP" Classes="meta"/>
                </StackPanel>
                <Grid ColumnDefinitions="*,120,Auto" ColumnSpacing="16">
                  <StackPanel><TextBlock Text="Сервер" Classes="label"/><TextBox x:Name="TxtSmtpServer" Text="smtp.ukr.net"/></StackPanel>
                  <StackPanel Grid.Column="1"><TextBlock Text="Порт" Classes="label"/><TextBox x:Name="TxtSmtpPort" Text="465"/></StackPanel>
                  <CheckBox Grid.Column="2" Content="SSL/TLS" IsChecked="True" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                </Grid>
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="16">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="4">
                    <TextBlock Text="Вхідна пошта" FontWeight="SemiBold"/>
                    <TextBlock Text="Протокол отримання листів" Classes="meta"/>
                  </StackPanel>
                  <ComboBox Grid.Column="1" SelectedIndex="1" Width="120" VerticalAlignment="Center">
                    <ComboBoxItem Content="POP3"/>
                    <ComboBoxItem Content="IMAP"/>
                  </ComboBox>
                </Grid>
                <Grid ColumnDefinitions="*,120,Auto" ColumnSpacing="16">
                  <StackPanel><TextBlock Text="Сервер" Classes="label"/><TextBox x:Name="TxtImapServer" Text="imap.ukr.net"/></StackPanel>
                  <StackPanel Grid.Column="1"><TextBlock Text="Порт" Classes="label"/><TextBox x:Name="TxtImapPort" Text="993"/></StackPanel>
                  <CheckBox Grid.Column="2" Content="SSL/TLS" IsChecked="True" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                </Grid>
              </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="12">
              <ToggleButton x:Name="BtnSave" Classes="primary" Content="Зберегти" Padding="24,0"
                            IsChecked="{Binding #BtnSettings.IsChecked, Mode=TwoWay}"/>
              <Button x:Name="BtnTest" Classes="flat" Content="Перевірити з'єднання"/>
            </StackPanel>

          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- ================= РЯДОК СТАНУ ================= -->
    <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
            BorderThickness="0,1,0,0" Padding="16,6">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock x:Name="StatusLeft" Text="● IMAP · не підключено" FontSize="11" Foreground="{StaticResource Muted}"/>
        <TextBlock x:Name="StatusRight" Grid.Column="1" Text="" FontSize="11" Foreground="{StaticResource Muted}"/>
      </Grid>
    </Border>

  </Grid>
</Window>
